# Copier ce fichier en ".env" à la racine du repo, puis remplacer les valeurs
# "changeme*" par de vrais secrets (surtout avant tout déploiement en prod).
# Voir DOCKER.md section 6 pour le détail de chaque variable.

# ===== Général =====
APP_ENV=dev
APP_SECRET=changeme-generate-a-real-random-secret

# ===== MySQL =====
MYSQL_DATABASE=taskmanager
MYSQL_USER=app
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_PORT=3306

# Hôte "mysql" = nom du service Docker Compose, pas localhost : les
# conteneurs se joignent entre eux par nom de service sur le réseau interne.
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}?serverVersion=8.4.3&charset=utf8mb4"

# ===== JWT (LexikJWTAuthenticationBundle) =====
JWT_PASSPHRASE=changeme-jwt-passphrase
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_REFRESH_TOKEN_TTL=2592000

# ===== CORS (NelmioCorsBundle) =====
# Dev : localhost + IP de réseau local (192.168.x.x / 10.x.x.x), pour pouvoir
# ouvrir le front via l'IP de la machine. En prod : le domaine public réel.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|192\.168\.[0-9]+\.[0-9]+|10\.[0-9]+\.[0-9]+\.[0-9]+)(:[0-9]+)?$'

# ===== URLs / mail =====
FRONTEND_URL=http://localhost:3000
DEFAULT_URI=http://localhost:8000
MAILER_DSN=null://null

# ===== Ports publiés sur l'hôte =====
FRONT_PORT=3000
BACK_HTTP_PORT=8000
ADMINER_PORT=8080

# ===== Front =====
# URL appelée par le NAVIGATEUR, inlinée dans le bundle JS au moment du
# `npm run build` (voir front/Dockerfile) : doit pointer vers BACK_HTTP_PORT
# ci-dessus, tel qu'accessible depuis la machine qui ouvre le navigateur.
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL interne conteneur-à-conteneur (réseau Docker). Non utilisée par le code
# actuel : toutes les pages sont des Client Components ('use client'), donc
# aucun fetch ne part du conteneur front lui-même. Gardée prête pour le jour
# où une route serveur (SSR / route handler) appellerait le back directement.
API_URL_INTERNAL=http://nginx

# ===== Prod uniquement (docker-compose.prod.yml / Makefile up-prod) =====
# Registre et tag utilisés pour nommer les images buildées.
REGISTRY=taskmanager
TAG=latest
