# Uniquement pour lancer le front HORS Docker (npm run dev), avec l'API Symfony
# sur le port 8000 de la même machine : copier ce fichier en front/.env.local.
#
# Sous Docker (docker-compose.yml / docker-compose.prod.yml), ce fichier n'est
# PAS utilisé : NEXT_PUBLIC_API_URL y est vide, le front appelle l'API en
# relatif (/api/...) via nginx, quelle que soit l'IP du serveur.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
