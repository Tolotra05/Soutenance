# Copier en jenkins/.env (non versionné) puis compléter. Voir JENKINS.md.

# Compte administrateur de l'interface Jenkins
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=changeme-jenkins

# Port de l'interface (8080 : arrêter d'abord l'ancien Jenkins qui l'occupe)
JENKINS_PORT=8080
# Adresse de l'interface telle que tapée dans le navigateur (liens des e-mails Jenkins)
JENKINS_URL=http://localhost:8080/

# Dépôt et branche construits par le pipeline
REPO_URL=https://github.com/Tolotra05/Soutenance.git
REPO_BRANCH=master

# .env de prod (chemin ABSOLU) : devient la credential taskmanager-env
#   Linux   : /home/mao/projet/Soutenance/.env
#   Windows : D:/WORK/OTHER/Stage/Mao/Soutenance/.env.prod (barres obliques /)
PROD_ENV_FILE=/home/mao/projet/Soutenance/.env
# Projet Docker Compose de la prod (nom affiché par `docker compose ls`)
#   Windows avec le dev sur la même machine : taskmanager-prod (prod séparée)
PROD_PROJECT=soutenance

# Groupe propriétaire du socket Docker
#   Linux : getent group docker | cut -d: -f3      Windows (Docker Desktop) : 0
DOCKER_GID=999
